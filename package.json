{
  "name": "nobrain-festival-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "학교 축제 실시간 단답형 퀴즈 (Cloudflare Workers + Durable Objects) — 시험 버전",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev --port 8787",
    "dev:ui": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "codes": "node tools/codes.mjs",
    "loadtest": "node loadtest/run.mjs",
    "cf-types": "wrangler types --env-interface Env worker/worker-configuration.d.ts",
    "deploy:test": "npm run build && wrangler deploy --env test"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "undici": "7.30.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.148.0",
    "ws": "8.22.0"
  }
}
