// 학교 축제 실시간 퀴즈 — Wrangler 설정
// - 최상위 설정: 로컬 개발(wrangler dev) 전용. 배포하지 않는다.
// - env.test: 시험용 Cloudflare 배포. 기존 운영 Worker 와 겹치지 않는 별도 이름을 쓴다.
// 비밀값(HOST_PASSWORD, SESSION_SECRET)은 여기 적지 않는다. 로컬은 .dev.vars, 배포는 `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nobrain-quiz-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api, /ws 만 Worker 가 먼저 받는다. 나머지는 정적 파일(무료·무제한 요청).
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "EVENTS", "class_name": "EventDO" },
      { "name": "BOTS", "class_name": "BotsDO" }
    ]
  },
  // 연습용 봇이 실제 참가 경로로 요청하도록 자기 자신을 가리키는 서비스 바인딩
  "services": [{ "binding": "SELF", "service": "nobrain-quiz-local" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EventDO"] },
    { "tag": "v2", "new_sqlite_classes": ["BotsDO"] }
  ],
  "observability": { "enabled": true },
  "vars": {
    // 쉼표로 구분한 추가 허용 Origin (vite dev 서버 등). 같은 출처는 항상 허용.
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "APP_ENV": "local"
  },
  "env": {
    "test": {
      "name": "nobrain-festival-quiz-test",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/ws"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "EVENTS", "class_name": "EventDO" },
          { "name": "BOTS", "class_name": "BotsDO" }
        ]
      },
      "services": [{ "binding": "SELF", "service": "nobrain-festival-quiz-test" }],
      "observability": { "enabled": true },
      "vars": {
        "ALLOWED_ORIGINS": "",
        "APP_ENV": "cloud-test"
      }
    }
  }
}
